{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://vaxmoment.example/schemas/golden-set.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "artifactStatus", "version", "description", "globalAssertions", "cases"],
  "properties": {
    "$schema": { "const": "./golden-set.schema.json" },
    "artifactStatus": { "const": "fixture_only_not_executed_not_parkway_approved" },
    "version": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "globalAssertions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clinicalAnswerRoutesAllowed", "rawInputMayBePersisted", "confirmationRequiredForAllClassifications", "unknownOutputFieldsAllowed"],
      "properties": {
        "clinicalAnswerRoutesAllowed": { "const": 0 },
        "rawInputMayBePersisted": { "const": false },
        "confirmationRequiredForAllClassifications": { "const": true },
        "unknownOutputFieldsAllowed": { "const": false }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "locale", "input", "expectedOutput", "mustNotContain"],
        "properties": {
          "id": { "type": "string", "pattern": "^GS-[0-9]{3}$" },
          "locale": { "type": "string", "minLength": 2 },
          "input": { "type": "string", "minLength": 1 },
          "expectedOutput": { "$ref": "../schemas/barrier-classification.schema.json" },
          "mustNotContain": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
